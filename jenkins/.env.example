# Copia este archivo como "jenkins/.env" y cambia los valores.
# El archivo .env NO se sube al repositorio (esta en .gitignore).

# Usuario administrador de Jenkins
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=cambia_esta_clave

# Contrasena de PostgreSQL que Jenkins guarda como credencial "postgres-password"
POSTGRES_CI_PASSWORD=cambia_esta_contrasena

# Puerto del equipo donde se publica Jenkins
JENKINS_PORT=8080
